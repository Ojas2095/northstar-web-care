# ============================================================
# Northstar Web Care — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# --- Contact Form ---
# Email service for contact form delivery (not yet configured)
# Options: Resend, SendGrid, or similar
# VITE_EMAIL_SERVICE_API_KEY=your_api_key_here
# VITE_CONTACT_EMAIL=hello@northstarwebcare.com

# --- Analytics (optional) ---
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Site URL ---
VITE_SITE_URL=http://localhost:3000

# --- Feature Flags ---
VITE_DEMO_MODE=true
